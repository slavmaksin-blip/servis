# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789

# Channel
CHANNEL_ID=@your_channel
CHANNEL_URL=https://t.me/your_channel

# SMSSEND API (https://smssend.ch)
SMSSEND_ACCOUNT=your_account
SMSSEND_PASSWORD=your_password

# MailBuy API (https://mailbuy.cc)
MAILBUY_TOKEN=your_mailbuy_token

# CryptoBot (https://t.me/CryptoBot)
CRYPTOBOT_TOKEN=your_cryptobot_token

# xRocket (https://t.me/xRocketBot)
XROCKET_TOKEN=your_xrocket_token

# Database path (optional, default: database.db)
DATABASE_PATH=database.db
