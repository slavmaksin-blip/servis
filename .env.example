# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram User IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# SMSSend API credentials
SMSSEND_API_KEY=your_smssend_api_key
SMSSEND_API_URL=https://sms-send.cc/api

# MailBuy API credentials
MAILBUY_API_KEY=your_mailbuy_api_key
MAILBUY_API_URL=https://api.mailbuy.cc

# Database path
DATABASE_PATH=data/bot.db
