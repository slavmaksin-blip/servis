# Telegram Bot token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Comma-separated list of admin Telegram user IDs
ADMIN_IDS=123456789,987654321

# SMSSend API credentials (http://47.236.91.242:20003)
SMSSEND_ACCOUNT=your_smssend_account
SMSSEND_PASSWORD=your_smssend_password

# AnyMessage Shop (mailbuy) API token (https://api.anymessage.shop)
MAILBUY_TOKEN=your_mailbuy_token

# Path to the SQLite database file (default: bot.db)
DATABASE_PATH=bot.db
