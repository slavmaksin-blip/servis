# Telegram Bot token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs that can use /smtp
ADMIN_IDS=123456789,987654321

# SMTP settings (used when smtp_override.json does not exist)
SMTP_HOST=smtp.mail.ch
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
